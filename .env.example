# Public client credentials only; never paste a service-role/secret key here.
# Leave both blank for the preserved Phase 1 mock experience.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# auto: mock only when BOTH credentials are absent; partial/invalid configuration fails closed.
# mock: explicitly run local fixtures even when a project is configured.
# supabase: require complete valid client configuration.
EXPO_PUBLIC_BACKEND_MODE=auto
