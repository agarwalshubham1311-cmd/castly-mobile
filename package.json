  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node tests/browser.cjs",
    "test:portraits": "node tests/portraits-browser.cjs",
    "lint": "eslint .",
    "test:ui": "node tests/lavender-browser.cjs",
    "preview": "node scripts/serve-web.cjs",
    "export:web": "expo export --platform web --output-dir dist-web",
    "test:screenshots": "node tests/verify-screenshots.cjs",
    "assets:branding": "node scripts/prepare-branding.cjs",
    "test:accessibility": "node tests/accessibility-browser.cjs",
    "test:sql": "node scripts/test-sql.cjs",
    "test:backend": "node tests/backend-browser.cjs",
    "check:client-env": "node scripts/check-client-env.cjs",
    "export:all": "expo export --platform all --output-dir dist"
