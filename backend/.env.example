# Use a restricted PostgreSQL role; never use service_role credentials here.
DATABASE_URL=jdbc:postgresql://YOUR_DATABASE_HOST:5432/postgres?sslmode=require
DATABASE_USERNAME=YOUR_RESTRICTED_DB_USER
DATABASE_PASSWORD=YOUR_DB_PASSWORD
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
PORT=8080
