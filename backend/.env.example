# Spring only. Never prefix DB credentials with EXPO_PUBLIC_. Never use postgres/admin/service-role.
# Approve/apply the forward migration and provision castly_api LOGIN/password before configuring a hosted DB.
DATABASE_URL="jdbc:postgresql://YOUR_DATABASE_HOST:5432/postgres?sslmode=verify-full&sslrootcert=/path/to/trusted-root.crt&prepareThreshold=0"
DATABASE_USERNAME=castly_api
DATABASE_PASSWORD="YOUR_DEDICATED_ROLE_PASSWORD"
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# jwks: RS256/ES256 signatures verified against the pinned project's public keys.
# supabase-auth: legacy HS256/overlap tokens verified by the project's Auth /user endpoint.
JWT_SIGNING_MODE=jwks
# Required ONLY in supabase-auth mode; publishable/anon key, never service_role or JWT signing secret.
SUPABASE_PUBLISHABLE_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
PORT=8080
