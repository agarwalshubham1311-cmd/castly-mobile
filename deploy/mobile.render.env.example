# Public build configuration ONLY. Copy into a separate review worktree's ignored .env.local.
CASTLY_RELEASE_CHECK=1
EXPO_PUBLIC_BACKEND_MODE=supabase
EXPO_PUBLIC_BUSINESS_API_MODE=spring
EXPO_PUBLIC_ISOLATED_SUPABASE_FALLBACK=false
EXPO_PUBLIC_API_URL=https://YOUR-RENDER-SERVICE.onrender.com
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Native EAS builds only: choose an owned package and an actual EAS project UUID.
CASTLY_ANDROID_PACKAGE=
EXPO_EAS_PROJECT_ID=
