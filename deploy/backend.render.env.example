# SERVER ONLY. Enter actual values in Render, never in Expo/EAS or a committed file.
# Copy the exact session-pooler hostname/ref from Supabase Connect; do not guess the region.
DATABASE_URL=jdbc:postgresql://YOUR-SESSION-POOLER-HOST:5432/postgres?sslmode=verify-full&sslrootcert=/etc/secrets/supabase-root.crt&prepareThreshold=0&connectTimeout=10&tcpKeepAlive=true
DATABASE_USERNAME=castly_api.YOUR_PROJECT_REF
DATABASE_PASSWORD=
SUPABASE_JWT_ISSUER=https://YOUR-PROJECT-REF.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Preserve the working project's actual signing mode: jwks OR supabase-auth.
JWT_SIGNING_MODE=
# Required only for supabase-auth; publishable/anon key, NEVER service_role or signing secret.
SUPABASE_PUBLISHABLE_KEY=
CORS_ALLOWED_ORIGINS=https://YOUR-STATIC-SITE.onrender.com
CASTLY_NOTIFICATIONS_ENABLED=false
CASTLY_BOOKING_DIAGNOSTICS_ENABLED=false
# Render provides PORT. Add the approved public CA as Secret File supabase-root.crt.
